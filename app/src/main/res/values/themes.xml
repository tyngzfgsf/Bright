<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bright.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_bright_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Bright</item>
    </style>

    <style name="Theme.Bright" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
