{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bright-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    "FIREBASE_PROJECT_ID": "bright-34c23",
    // Exact origins only: the site (the web app now lives inside it), the old standalone demo
    // until it is retired, and the local dev server.
    "ALLOWED_ORIGINS": "https://bright-web.jchang2032.workers.dev,https://bright-demo.jchang2032.workers.dev,http://localhost:3000",
    // Billing (see MONETIZATION.md). Paddle price ids are public; fill these in from the
    // Paddle dashboard. Empty values just leave that integration off.
    "PADDLE_ENV": "sandbox",
    "PADDLE_PRICES": "{}",
    "PADDLE_RETENTION_DISCOUNT_ID": "",
    "EMAIL_FROM": ""
  },
  // Secrets, never vars:  npx wrangler secret put <NAME>
  //   GROQ_API_KEY, RC_SECRET_KEY, RC_WEBHOOK_AUTH, PADDLE_API_KEY, PADDLE_WEBHOOK_SECRET, RESEND_API_KEY
  // For `wrangler dev`, put them in .dev.vars (gitignored).
  "durable_objects": {
    "bindings": [
      { "name": "QUOTA", "class_name": "QuotaCounter" },
      { "name": "ACCOUNT", "class_name": "Account" }
    ]
  },
  // new_sqlite_classes: SQLite-backed Durable Objects are the kind the free plan allows.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["QuotaCounter"] },
    { "tag": "v2", "new_sqlite_classes": ["Account"] }
  ]
}
